# IdeaPrism 2.0 프로토타입 — 환경변수 예시
# 이 파일을 복사해 `.env.local` 로 저장한 뒤, 아래 값을 채워 주세요.
# `.env.local` 은 절대 커밋되지 않습니다(.gitignore 처리됨).
#
#   cp .env.local.example .env.local
#
# ─────────────────────────────────────────────────────────────
# 1) AI 모델 키 — 셋 중 "하나 이상"만 있으면 대화가 됩니다.
#    셋 다 넣으면 화면 상단에서 골라 가며 비교할 수 있습니다.
#    (대화 도중에는 못 바꿉니다. 바꾸면 새 대화로 다시 시작합니다)
# ─────────────────────────────────────────────────────────────

# Claude — https://console.anthropic.com/ → API Keys
# 키는 sk-ant- 로 시작합니다.
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
# 키는 sk- 로 시작합니다.
OPENAI_API_KEY=

# Gemini — https://aistudio.google.com/apikey (무료 티어 있음)
GEMINI_API_KEY=

# 기본으로 고를 회사 (claude | openai | gemini). 비워 두면 claude 입니다.
# 그 회사 키가 없으면 키가 있는 곳으로 자동으로 넘어갑니다.
DEFAULT_AI_PROVIDER=

# 모델을 바꿔 가며 시험하려면 여기서 지정하세요 (비워 두면 아래 기본값).
#   CLAUDE_MODEL=claude-sonnet-5
#   OPENAI_MODEL=gpt-5.4-mini
#   GEMINI_MODEL=gemini-3.6-flash

# ─────────────────────────────────────────────────────────────
# 2) Supabase — 1.0과 "같은 프로젝트"를 공유합니다.
#    1.0 Vercel 대시보드 → Settings → Environment Variables
#    → 항목 우측 ⋯ → Edit 을 눌러야 실제 값이 보입니다.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 키(발명노트 저장에 사용). 브라우저에 절대 노출되지 않습니다.
SUPABASE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# 3) KIPRIS — 1.0의 값을 그대로 재사용 (5단계 특허 조회)
# ─────────────────────────────────────────────────────────────
KIPRIS_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────
# 4) 관리자 페이지 (/admin) — 캐릭터 대본과 대화 흐름을 고치는 곳
#
#    프롬프트는 이 서비스의 두뇌라 잠금 없이 열지 않습니다.
#    이 값이 비어 있으면 관리자 페이지 자체가 열리지 않습니다.
#    원하는 코드를 직접 정해 넣으세요 (남이 못 맞힐 만한 것으로).
#
#    ※ 처음 한 번은 supabase/prompt_overrides.sql 을 Supabase에서 실행해야
#      고친 내용이 저장됩니다. 실행 전에도 화면은 열리고 원본은 볼 수 있습니다.
# ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────
# 5) 비용 가드 (선택) — 값이 없으면 아래 기본값이 적용됩니다.
# ─────────────────────────────────────────────────────────────
# 세션 1개당 허용할 AI 호출 횟수 상한 (기본 120)
MAX_AI_CALLS_PER_SESSION=120
