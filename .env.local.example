# IdeaPrism 2.0 프로토타입 — 환경변수 예시
# 이 파일을 복사해 `.env.local` 로 저장한 뒤, 아래 값을 채워 주세요.
# `.env.local` 은 절대 커밋되지 않습니다(.gitignore 처리됨).
#
#   cp .env.local.example .env.local
#
# ─────────────────────────────────────────────────────────────
# 1) Claude API — Anthropic 콘솔에서 발급
#    https://console.anthropic.com/ → API Keys → Create Key
#    (프로토타입 기간에는 월 사용 한도 설정을 권장합니다)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# 2) Supabase — 1.0과 "같은 프로젝트"를 공유합니다.
#    1.0 Vercel 대시보드의 환경변수 값을 그대로 복사해 주세요.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 키(발명노트 저장에 사용). 브라우저에 절대 노출되지 않습니다.
SUPABASE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# 3) KIPRIS — 1.0의 값을 그대로 재사용 (P4 특허 연결 단계에서 사용)
# ─────────────────────────────────────────────────────────────
KIPRIS_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────
# 4) 비용 가드 (선택) — 값이 없으면 아래 기본값이 적용됩니다.
# ─────────────────────────────────────────────────────────────
# 세션 1개당 허용할 AI 호출 횟수 상한 (기본 120)
MAX_AI_CALLS_PER_SESSION=120
